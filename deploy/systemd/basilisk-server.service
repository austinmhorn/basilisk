[Unit]
Description=Basilisk authoritative WebSocket server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=basilisk
Group=basilisk
EnvironmentFile=/etc/basilisk/server.env
StateDirectory=basilisk
StateDirectoryMode=0750
WorkingDirectory=/opt/basilisk
ExecStart=/opt/basilisk/bin/BasiliskServer --bind ${BASILISK_BIND_ADDRESS} --port ${BASILISK_PORT} --auth-db ${BASILISK_AUTH_DATABASE} --trophy-db ${BASILISK_TROPHY_DATABASE} --ai-policy ${BASILISK_AI_POLICY} --ai-model ${BASILISK_AI_MODEL} --ai-canary-percent ${BASILISK_AI_CANARY_PERCENT} --ai-canary-difficulties ${BASILISK_AI_CANARY_DIFFICULTIES} --ai-shadow-output ${BASILISK_AI_TELEMETRY}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/basilisk

[Install]
WantedBy=multi-user.target
