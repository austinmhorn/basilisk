# Install as /etc/basilisk/server.env, owned by root:basilisk and mode 0640.
# Keep the authoritative listener on loopback when using the reverse proxy.
BASILISK_BIND_ADDRESS=127.0.0.1
BASILISK_PORT=8765
BASILISK_AUTH_DATABASE=/var/lib/basilisk/auth.sqlite3
BASILISK_TROPHY_DATABASE=/var/lib/basilisk/trophies.sqlite3

# Safe defaults keep every AI on the heuristic policy. Set policy=canary and
# percent=1 for the monitored Medium/Hard canary documented in
# deploy/PRODUCTION_DEPLOYMENT.md.
BASILISK_AI_POLICY=heuristic
BASILISK_AI_MODEL=/opt/basilisk/models/heuristic-imitation-v3.model
BASILISK_AI_CANARY_PERCENT=0
BASILISK_AI_CANARY_DIFFICULTIES=medium,hard
BASILISK_AI_TELEMETRY=/var/lib/basilisk/ai-canary.jsonl
